<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Diary</title>
<link rel="stylesheet" href="style.css">

<!-- Firebase -->
<script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
</head>
<body>

<canvas id="bubbleCanvas"></canvas>

<div class="container">
    <h3 align="center">Diary</h3>
    <form id="diaryForm">
        <label>Nama</label>
        <input type="text" id="nama" required>

        <label>Tanggal</label>
        <input type="date" id="tanggal" required>

        <label>Judul</label>
        <input type="text" id="judul" required>

        <label>Isi Diary</label>
        <textarea id="isi" rows="4" required></textarea>

        <label>Mood Hari Ini</label>
        <div class="mood-bubble">
            <label>
                <input type="radio" name="mood" value="Senang" checked>
                <span>😊 Senang</span>
            </label>
            <label>
                <input type="radio" name="mood" value="Sedih">
                <span>😔 Sedih</span>
            </label>
            <label>
                <input type="radio" name="mood" value="Biasa">
                <span>🙂 Biasa</span>
            </label>
        </div>

        <button type="submit">Simpan</button>
    </form>
</div>

<script src="script.js"></script>
</body>
</html>
